{
  "name": "@photon-ai/mcp-core",
  "version": "0.1.2",
  "description": "Compile an OpenAPI document into MCP tools and execute them over HTTP.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "photon"
  ],
  "homepage": "https://github.com/photon-hq/mcp-server/tree/main/packages/core#readme",
  "bugs": "https://github.com/photon-hq/mcp-server/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/mcp-server.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "photon-mcp-compile": "./dist/bin/compile-release.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.10",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
