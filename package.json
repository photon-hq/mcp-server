{
  "name": "mcp-server-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "biome check --config-path ultracite.jsonc --no-errors-on-unmatched packages",
    "check-types": "pnpm -r check-types",
    "test": "pnpm -r test",
    "verify": "pnpm build && pnpm test && pnpm check && pnpm check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "ultracite": "7.10.7",
    "vitest": "4.1.0"
  }
}
